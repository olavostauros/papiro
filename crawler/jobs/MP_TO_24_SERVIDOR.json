 "patch": {
  "esp08": {
   "96": "A informação patrimonial, no tribunal de justiça, da conta única do tesouro referente ao recebimento de recurso de precatórios de um órgão devedor por decisão judicial evidenciará um ativo (D – caixa e equivalente de caixa) em contrapartida a uma receita orçamentária (C – variação patrimonial aumentativa)."
  },
  "esp12": {
   "93": "O antibiograma sugere uma infecção de tratamento simples, para o qual pode ser escolhido qualquer antibiótico β-lactâmico."
  },
  "esp20": {
   "53": "Um sistema de comunicação que opera em 16-QAM, com taxa de transmissão de símbolos de 1,0 × 10^6 baud e taxa média de erro de símbolo de 10^-2 possui throughput superior a 4 Mbps."
  }
 }
