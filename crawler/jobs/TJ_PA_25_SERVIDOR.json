 "patch": {
  "esp13": {
   "55": "Para ω^2 = 1/(L1·C1), a corrente I1 estará atrasada em 90° em relação à tensão de entrada Vi."
  },
  "esp14": {
   "89": "Em relação ao processo de expansão do vapor no bocal de Laval, a expressão w1−2 = Δh1−2 + 0,5 · (u2 − u1) permite estimar o trabalho (w) transferido pela turbina, consideradas a variação de entalpia (h) e velocidade (u) na entrada (1) e na saída (2) da turbina."
  },
  "esp15": {
   "56": "P(M ∩ C) = 0,6 × 0,3.",
   "58": "Se K representa o evento \"processo criminal\" e se C denota o evento \"processo cível\", então K e C são eventos independentes.",
   "59": "Denotada por P(C|M), a probabilidade condicional de um processo ter sido cível, dado que foi julgado em menos de 6 meses, é P(C|M) = 0,5.",
   "61": "E[X] ≥ E[Y].",
   "62": "X e Y são variáveis aleatórias independentes.",
   "63": "E[X|Y = y] = E[X] + y.",
   "64": "P(Y ≥ 3|X = 0) = 0,512.",
   "65": "A variância de Y é inferior a 18.",
   "66": "a diferença V − W segue uma distribuição exponencial com variância igual a 2.",
