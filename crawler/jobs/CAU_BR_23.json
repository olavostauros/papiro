 "patch": {
  "esp002": {
   "60": "As projeções cartográficas podem ser classificadas de acordo com o método de projeção, sendo o método geográfico o mais utilizado na cartografia moderna.",
   "117": "O coeficiente angular da reta de regressão linear simples da variável resposta Y sobre a variável regressora W — considerando que o intercepto não seja nulo — é igual a 2,4."
  },
  "esp011": {
   "108": "O foco do IGP-M, em sua cesta de apuração, recai sobre os bens de consumo final."
  }
