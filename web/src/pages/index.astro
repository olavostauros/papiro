---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import Card from '../design/components/Card.astro';
import Container from '../design/components/Container.astro';
import Select from '../design/components/Select.astro';
import PageHeader from '../design/components/PageHeader.astro';
import QuestionCard from '../design/components/QuestionCard.astro';
import {
  API_URL,
  EMPTY_FILTROS,
  EMPTY_PAGE,
  fetchFiltros,
  fetchQuestoes,
} from '../data/questions';

const PER_PAGE = 20;
// Build-time: SSR da 1ª página + opções dos Selects. Sem a API acessível,
// a página sai com listas vazias e <question-browser> tenta de novo no cliente.
const [filtros, primeira] = await Promise.all([
  fetchFiltros().catch(() => EMPTY_FILTROS),
  fetchQuestoes({ page: 1, per_page: PER_PAGE }).catch(() => EMPTY_PAGE),
]);

const campos = [
  { id: 'banca', label: 'Banca', placeholder: 'Todas', valores: filtros.bancas },
  { id: 'orgao', label: 'Órgão', placeholder: 'Todos', valores: filtros.orgaos },
  { id: 'cargo', label: 'Cargo', placeholder: 'Todos', valores: filtros.cargos },
  { id: 'ano', label: 'Ano', placeholder: 'Todos', valores: filtros.anos.map(String) },
  { id: 'assunto', label: 'Assunto', placeholder: 'Todos', valores: filtros.assuntos },
];
---

<Layout title="papiro — questões de concursos públicos">
  <SiteHeader />

  <Container as="main" id="conteudo" tabindex="-1" class="py-10">
    <PageHeader title="Provas e questões oficiais de concursos, de graça">
      Filtre por banca, órgão, cargo, ano e assunto. Resolva e confira o gabarito definitivo na
      hora, com a fonte de cada questão. Sem cadastro.
    </PageHeader>

    <question-browser data-api-url={API_URL} data-per-page={PER_PAGE}>
      <Card
        as="section"
        aria-label="Filtros"
        class="mb-8 grid grid-cols-2 gap-3 p-4 sm:grid-cols-3 lg:grid-cols-5"
      >
        {
          campos.map((f) => (
            <Select label={f.label} placeholder={f.placeholder} options={f.valores} data-filtro={f.id} />
          ))
        }
        <p class="col-span-full text-sm text-ink-soft" role="status">
          <span data-contagem>{primeira.total}</span> questões
        </p>
      </Card>

      <section class="space-y-4" aria-label="Questões" data-lista>
        {primeira.items.map((q) => <QuestionCard q={q} />)}
      </section>

      <nav class="mt-6 flex items-center justify-center gap-3" aria-label="Paginação" data-paginacao></nav>
      <p class="mt-4 text-center text-sm text-ink-soft" role="status" data-status hidden></p>
    </question-browser>
  </Container>

  <SiteFooter />

  <script>
    import '../design/elements/question-browser';
  </script>
</Layout>
