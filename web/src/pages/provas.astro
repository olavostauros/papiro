---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import Badge from '../design/components/Badge.astro';
import Card from '../design/components/Card.astro';
import Container from '../design/components/Container.astro';
import EmptyState from '../design/components/EmptyState.astro';
import Input from '../design/components/Input.astro';
import Link from '../design/components/Link.astro';
import PageHeader from '../design/components/PageHeader.astro';
import { plural, resumoAnos, resumoCargos } from '../design/templates';
import { API_URL, fetchEventos, type Evento } from '../data/questions';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const eventos = API_URL
  ? await fetchEventos().catch((err) => {
      console.warn('provas SSR /eventos:', err);
      return [];
    })
  : [];

const normaliza = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '');

/** Título legível do evento: "Órgão — ano". Sem órgão (API antiga), o slug. */
const tituloEvento = (ev: Evento): string => {
  const orgaos = ev.orgaos ?? [];
  if (!orgaos.length) return ev.evento;
  const nome =
    orgaos.length === 1
      ? orgaos[0]
      : orgaos.length === 2
        ? orgaos.join(' · ')
        : `${orgaos[0]} e mais ${orgaos.length - 1} órgãos`;
  const anos = resumoAnos(ev.anos ?? []);
  return anos ? `${nome} — ${anos}` : nome;
};

/** Linha de descrição: primeiros cargos + "e mais N cargos" (vazio sem cargos). */
const descricaoEvento = (ev: Evento): string => resumoCargos(ev.cargos ?? []);

---

<Layout title="papiro — provas" description="Concursos já catalogados no acervo do papiro, com as provas e questões de cada evento.">
  <SiteHeader />

  <Container as="main" id="conteudo" tabindex="-1" class="py-10">
    <PageHeader title="Provas">
      Cada evento reúne as provas de um concurso do acervo. Abra um deles para listar
      as provas ou vá direto para as questões.
    </PageHeader>

    {
      eventos.length > 0 ? (
        <evento-list data-api-url={API_URL}>
          <Card as="section" aria-label="Filtrar eventos" class="mb-8 p-4">
            <Input
              label="Filtrar eventos"
              type="search"
              placeholder="Órgão, cargo, banca ou ano…"
              data-busca
            />
            <p class="mt-3 text-sm text-ink-soft" role="status" data-contagem>
              {plural(eventos.length, 'evento')}
            </p>
          </Card>

          <ul class="space-y-3" aria-label="Eventos">
            {eventos.map((ev) => {
              const titulo = tituloEvento(ev);
              const descricao = descricaoEvento(ev);
              const buscaTexto = normaliza(
                [
                  ev.evento,
                  ev.banca,
                  ...(ev.orgaos ?? []),
                  ...(ev.cargos ?? []),
                  ...(ev.anos ?? []),
                ].join(' '),
              );
              return (
              <li data-evento-item data-busca-texto={buscaTexto}>
                <details
                  data-evento={ev.evento}
                  class="rounded-xl border border-line bg-surface p-5"
                >
                  <summary class="flex cursor-pointer flex-wrap items-baseline gap-x-3 gap-y-1 rounded-sm focus-visible:focus-ring">
                    <span class="font-medium text-ink">{titulo}</span>
                    <Badge>{ev.banca}</Badge>
                    {titulo !== ev.evento && (
                      <Badge variant="outline" class="font-mono">{ev.evento}</Badge>
                    )}
                    <span class="ml-auto text-sm text-ink-soft">
                      {plural(ev.provas, 'prova')} · {plural(ev.itens ?? ev.questoes, 'questão', 'questões')}
                    </span>
                    {descricao && (
                      <span class="basis-full text-sm text-ink-soft">{descricao}</span>
                    )}
                  </summary>
                  <div class="mt-3 border-t border-line pt-3">
                    <Link
                      href={`${base}/?evento=${encodeURIComponent(ev.evento)}`}
                      variant="underline"
                    >
                      Resolver as questões deste evento
                    </Link>
                    <div data-provas class="mt-3" role="status">
                      <p class="text-sm text-ink-soft">A lista de provas deste evento só carrega com JavaScript ativado.</p>
                    </div>
                  </div>
                </details>
              </li>
              );
            })}
          </ul>
        </evento-list>
      ) : (
        <EmptyState>
          Não foi possível carregar a lista de eventos — a API está indisponível no
          momento.
        </EmptyState>
      )
    }
  </Container>

  <SiteFooter />

  <script>
    import '../design/elements/evento-list';
  </script>
</Layout>
