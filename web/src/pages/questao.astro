---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import Button from '../design/components/Button.astro';
import Card from '../design/components/Card.astro';
import Container from '../design/components/Container.astro';
import EmptyState from '../design/components/EmptyState.astro';
import PageHeader from '../design/components/PageHeader.astro';
import QuestionCard from '../design/components/QuestionCard.astro';
import Textarea from '../design/components/Textarea.astro';
import { API_URL, fetchQuestao } from '../data/questions';

// Em build estático não há query string — a página nasce com o EmptyState e
// <questao-view> busca a questão no cliente. Se um dia houver SSR, renderiza
// já com o card.
const id = Astro.url.searchParams.get('id') ?? '';
const q = id
  ? await fetchQuestao(id).catch((err) => {
      console.warn(`questao SSR (${id}):`, err);
      return null;
    })
  : null;
---

<Layout title={q ? `papiro — ${q.id}` : 'papiro — questão'}>
  <SiteHeader />

  <Container as="main" id="conteudo" tabindex="-1" class="py-10">
    <PageHeader title="Questão">Página permanente de uma questão do acervo.</PageHeader>

    <questao-view data-api-url={API_URL}>
      <div data-alvo class="space-y-4">
        {
          q ? (
            <QuestionCard q={q} />
          ) : (
            <EmptyState>
              Informe o identificador da questão na URL — por exemplo,
              <code class="rounded-sm bg-accent-soft px-1 py-0.5 font-mono text-xs text-accent"
                >?id=cebraspe-2024-…</code
              >
              (o link Permalink de cada cartão aponta para cá).
            </EmptyState>
          )
        }
      </div>
      <p class="mt-4 text-center text-sm text-ink-soft" role="status" data-status hidden></p>

      {
        // Sem PUBLIC_API_URL nem o agente nem a questão carregam — o bloco
        // some por inteiro; sem JS resta a nota de [data-sem-js].
        API_URL && (
          <questao-explicar data-api-url={API_URL} class="mt-4">
            <Card as="section" aria-label="Explicar a questão" data-painel>
              <p data-sem-js class="text-sm text-ink-soft">
                A explicação do agente só funciona com JavaScript ativado.
              </p>
              <div data-form hidden class="space-y-3">
                <Textarea
                  label="Dúvida sobre a questão (opcional)"
                  rows={3}
                  placeholder="O que não ficou claro nesta questão?"
                  data-duvida
                  aria-describedby="duvida-contador"
                />
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <p id="duvida-contador" data-contador class="text-xs text-ink-faint">
                    0/500
                  </p>
                  <Button type="button" data-acao aria-label="Explicar a questão">
                    Explicar a questão
                  </Button>
                </div>
                <p data-erro role="alert" class="text-sm font-medium text-danger" hidden></p>
              </div>
              <div data-status role="status" class="mt-3" hidden>
                <p data-status-msg class="text-sm font-medium"></p>
                <p data-status-aux class="mt-0.5 text-sm text-ink-soft"></p>
              </div>
              <div data-resultado class="empty:hidden"></div>
            </Card>
          </questao-explicar>
        )
      }
    </questao-view>
  </Container>

  <SiteFooter />

  <script>
    import '../design/elements/questao-view';
    import '../design/elements/questao-explicar';
  </script>
</Layout>
