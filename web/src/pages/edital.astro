---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import Button from '../design/components/Button.astro';
import Card from '../design/components/Card.astro';
import Container from '../design/components/Container.astro';
import EmptyState from '../design/components/EmptyState.astro';
import Input from '../design/components/Input.astro';
import PageHeader from '../design/components/PageHeader.astro';
import Textarea from '../design/components/Textarea.astro';
import { API_URL } from '../data/questions';
---

<Layout title="papiro — edital">
  <SiteHeader />

  <Container as="main" id="conteudo" tabindex="-1" class="py-10">
    <PageHeader title="Cruzar o edital">
      Cole o conteúdo programático do edital e veja quantas questões do acervo
      cobrem cada tópico — cada um vira uma lista pronta para resolver.
    </PageHeader>

    {
      // O agente depende da API: sem PUBLIC_API_URL a página mostra o
      // EmptyState; sem JS, a nota de [data-sem-js] dentro do painel.
      API_URL ? (
        <edital-cruzamento data-api-url={API_URL}>
          <Card as="section" aria-label="Cruzar o edital" data-painel>
            <p data-sem-js class="text-ink-soft">
              O cruzamento do edital só funciona com JavaScript ativado.
            </p>
            <form data-form hidden class="space-y-4" novalidate>
              <Textarea
                label="Conteúdo programático do edital"
                rows={12}
                placeholder="Cole aqui o trecho do edital com as disciplinas e os tópicos da prova…"
                data-texto
                aria-describedby="edital-ajuda edital-contador"
              />
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-xs">
                <p id="edital-ajuda" class="text-ink-soft">
                  Entre 50 e 30.000 caracteres — só o conteúdo programático, não o edital
                  inteiro.
                </p>
                <p id="edital-contador" data-contador class="text-ink-faint">
                  0/30.000
                </p>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <Input label="Banca (opcional)" placeholder="Ex.: Cebraspe" data-banca />
                <Input
                  label="Cargo (opcional)"
                  placeholder="Ex.: Escrivão de Polícia Federal"
                  data-cargo
                />
              </div>
              <Button type="submit" data-acao>
                Cruzar o edital
              </Button>
              <p data-erro role="alert" class="text-sm font-medium text-danger" hidden></p>
            </form>
            <div data-status role="status" class="mt-3" hidden>
              <p data-status-msg class="text-sm font-medium"></p>
              <p data-status-aux class="mt-0.5 text-sm text-ink-soft"></p>
            </div>
            <div data-resultado class="empty:hidden"></div>
          </Card>
        </edital-cruzamento>
      ) : (
        <EmptyState>
          O cruzamento do edital depende da API — indisponível no momento.
        </EmptyState>
      )
    }
  </Container>

  <SiteFooter />

  <script>
    import '../design/elements/edital-cruzamento';
  </script>
</Layout>
