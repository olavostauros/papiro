---
import Alternativa from './Alternativa.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import Link from './Link.astro';
import QuestionMeta from './QuestionMeta.astro';
import Textarea from './Textarea.astro';
import type { Questao } from '../../data/questions';

interface Props {
  q: Questao;
}

const { q } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const letras = ['a', 'b', 'c', 'd', 'e'];
const certoErrado = q.tipo === 'certo_errado';
const opcoes = q.alternativas.map((alt, i) => ({
  valor: certoErrado ? alt.toLowerCase() : letras[i],
  letra: certoErrado ? undefined : letras[i].toUpperCase(),
  texto: alt,
}));
const gabaritoTexto = certoErrado
  ? q.gabarito === 'certo'
    ? 'Certo'
    : 'Errado'
  : `Alternativa ${q.gabarito.toUpperCase()}`;
const fonteOk = /^https?:/i.test(q.fonte);
const rotulo = `Questão — ${q.banca}, ${q.cargo}, ${q.ano}`;
---

<question-card
  data-id={q.id}
  data-banca={q.banca}
  data-orgao={q.orgao}
  data-cargo={q.cargo}
  data-ano={String(q.ano)}
  data-assunto={q.assunto}
  data-gabarito={q.gabarito}
  data-gabarito-texto={gabaritoTexto}
  data-filter-item
>
  <Card as="article" aria-label={rotulo}>
    <QuestionMeta banca={q.banca} orgao={q.orgao} cargo={q.cargo} ano={q.ano} assunto={q.assunto} />

    <p id={`enunciado-${q.id}`} class="mt-3 font-serif text-base leading-relaxed sm:text-lg">
      {q.enunciado}
    </p>

    {
      // Bloco retrátil do texto-base — cardHtml (templates.ts) replica este
      // markup. `q.texto.imagem` = texto só em imagem no PDF da banca.
      q.texto && (q.texto.conteudo || q.texto.imagem) && (
        <details class="mt-3 rounded-md border border-line bg-paper px-3 py-2">
          <summary class="cursor-pointer select-none text-xs font-medium text-ink-soft">
            Texto-base{q.texto.ref ? ` — ${q.texto.ref}` : ''}
          </summary>
          {q.texto.imagem ? (
            <p class="mt-2 text-sm text-ink-soft">
              O texto-base desta questão é uma imagem no caderno de prova — consulte a fonte oficial.
            </p>
          ) : (
            <div class="mt-2 space-y-3 font-serif text-sm leading-relaxed text-ink-soft">
              {q.texto.conteudo.split(/\n\n+/).map((par) => <p>{par}</p>)}
            </div>
          )}
          {q.texto.citacao && <p class="mt-2 text-xs italic text-ink-faint">{q.texto.citacao}</p>}
        </details>
      )
    }

    {
      opcoes.length > 0 && (
        <div
          class:list={['mt-3 grid gap-1.5', certoErrado && 'grid-cols-2']}
          role="radiogroup"
          aria-labelledby={`enunciado-${q.id}`}
        >
          {opcoes.map((op) => (
            <Alternativa valor={op.valor} letra={op.letra} class={certoErrado ? 'justify-center' : undefined}>
              {op.texto}
            </Alternativa>
          ))}
        </div>
      )
    }

    <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
      {
        // MC rara sem alternativas (62 registros): sem botão, gabarito inline
        opcoes.length > 0 ? (
          <>
            <Button variant="ghost" size="sm" type="button" data-ver-gabarito>Ver gabarito</Button>
            <p data-resultado role="status" class="hidden font-medium"></p>
          </>
        ) : (
          <p data-resultado role="status" class="font-medium text-accent">
            Gabarito: {gabaritoTexto}
          </p>
        )
      }
      {
        // Toggle do agente — nasce hidden; <questao-explicar> o revela com
        // id + API resolvidos. cardHtml (templates.ts) replica este markup.
      }
      <Button
        variant="ghost"
        size="sm"
        type="button"
        data-explicar-toggle
        aria-expanded="false"
        aria-controls={`explicar-${q.id}`}
        aria-label={`Explicar a questão — ${q.id}`}
        hidden
      >
        Explicar a questão
      </Button>
      <div class="ml-auto flex items-center gap-4">
        <Link
          href={`${base}/questao/?id=${encodeURIComponent(q.id)}`}
          aria-label={`Página da questão — ${q.banca}, ${q.cargo}, ${q.ano}`}
        >
          Permalink
        </Link>
        {
          fonteOk ? (
            <Link
              href={q.fonte}
              variant="underline"
              aria-label={`Fonte oficial — ${q.banca}, ${q.cargo}, ${q.ano}`}
            >
              Fonte oficial
            </Link>
          ) : (
            <span>Fonte indisponível</span>
          )
        }
      </div>
    </div>

    {
      // Painel embutido do agente — recolhido (hidden); o toggle no rodapé
      // o abre. Dentro de <questao-view> o elemento fica inerte (dedup —
      // a página tem o painel próprio). cardHtml replica este markup.
    }
    <questao-explicar>
      <div data-painel id={`explicar-${q.id}`} hidden class="mt-4 space-y-3 border-t border-line pt-4">
        <div data-form class="space-y-3">
          <Textarea
            label="Dúvida sobre a questão (opcional)"
            rows={2}
            placeholder="O que não ficou claro nesta questão?"
            data-duvida
            aria-describedby={`duvida-contador-${q.id}`}
          />
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p id={`duvida-contador-${q.id}`} data-contador class="text-xs text-ink-faint">
              0/500
            </p>
            <Button type="button" size="sm" data-acao aria-label={`Explicar a questão — ${q.id}`}>
              Explicar a questão
            </Button>
          </div>
          <p data-erro role="alert" class="text-sm font-medium text-danger" hidden></p>
        </div>
        <div data-status role="status" hidden>
          <p data-status-msg class="text-sm font-medium"></p>
          <p data-status-aux class="mt-0.5 text-sm text-ink-soft"></p>
        </div>
        <div data-resultado class="empty:hidden"></div>
      </div>
    </questao-explicar>
  </Card>
</question-card>

<script>
  import '../elements/question-card';
  import '../elements/questao-explicar';
</script>
