---
import Alternativa from './Alternativa.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import Link from './Link.astro';
import QuestionMeta from './QuestionMeta.astro';
import type { Questao } from '../../data/questions';

interface Props {
  q: Questao;
}

const { q } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const letras = ['a', 'b', 'c', 'd', 'e'];
const certoErrado = q.tipo === 'certo_errado';
const opcoes = q.alternativas.map((alt, i) => ({
  valor: certoErrado ? alt.toLowerCase() : letras[i],
  letra: certoErrado ? undefined : letras[i].toUpperCase(),
  texto: alt,
}));
const gabaritoTexto = certoErrado
  ? q.gabarito === 'certo'
    ? 'Certo'
    : 'Errado'
  : `Alternativa ${q.gabarito.toUpperCase()}`;
const fonteOk = /^https?:/i.test(q.fonte);
const rotulo = `Questão — ${q.banca}, ${q.cargo}, ${q.ano}`;
---

<question-card
  data-id={q.id}
  data-banca={q.banca}
  data-orgao={q.orgao}
  data-cargo={q.cargo}
  data-ano={String(q.ano)}
  data-assunto={q.assunto}
  data-gabarito={q.gabarito}
  data-gabarito-texto={gabaritoTexto}
  data-filter-item
>
  <Card as="article" aria-label={rotulo}>
    <QuestionMeta banca={q.banca} orgao={q.orgao} cargo={q.cargo} ano={q.ano} assunto={q.assunto} />

    <p id={`enunciado-${q.id}`} class="mt-3 font-serif text-base leading-relaxed sm:text-lg">
      {q.enunciado}
    </p>

    {
      opcoes.length > 0 && (
        <div
          class:list={['mt-3 grid gap-1.5', certoErrado && 'grid-cols-2']}
          role="radiogroup"
          aria-labelledby={`enunciado-${q.id}`}
        >
          {opcoes.map((op) => (
            <Alternativa valor={op.valor} letra={op.letra} class={certoErrado && 'justify-center'}>
              {op.texto}
            </Alternativa>
          ))}
        </div>
      )
    }

    <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
      {
        // MC rara sem alternativas (62 registros): sem botão, gabarito inline
        opcoes.length > 0 ? (
          <>
            <Button variant="ghost" size="sm" type="button" data-ver-gabarito>Ver gabarito</Button>
            <p data-resultado role="status" class="hidden font-medium"></p>
          </>
        ) : (
          <p data-resultado role="status" class="font-medium text-accent">
            Gabarito: {gabaritoTexto}
          </p>
        )
      }
      <div class="ml-auto flex items-center gap-4">
        <Link
          href={`${base}/questao/?id=${encodeURIComponent(q.id)}`}
          aria-label={`Página da questão — ${q.banca}, ${q.cargo}, ${q.ano}`}
        >
          Permalink
        </Link>
        {
          fonteOk ? (
            <Link
              href={q.fonte}
              variant="underline"
              aria-label={`Fonte oficial — ${q.banca}, ${q.cargo}, ${q.ano}`}
            >
              Fonte oficial
            </Link>
          ) : (
            <span>Fonte indisponível</span>
          )
        }
      </div>
    </div>
  </Card>
</question-card>

<script>
  import '../elements/question-card';
</script>
