---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'subtle' | 'underline';
  class?: string;
}

const { href, variant = 'subtle', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  {...rest}
  class:list={[
    'rounded-sm text-ink-soft transition-colors hover:text-ink focus-visible:focus-ring',
    variant === 'underline' && 'underline decoration-line underline-offset-2',
    className,
  ]}
>
  <slot />
</a>
