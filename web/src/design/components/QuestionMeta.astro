---
interface Props {
  banca: string;
  orgao: string;
  cargo: string;
  ano: number;
  assunto: string;
}

const { banca, orgao, cargo, ano, assunto } = Astro.props;
---

<p class="flex flex-wrap gap-x-2 gap-y-1 text-xs text-ink-soft">
  <span class="font-medium text-ink">{banca}</span>
  <span aria-hidden="true">·</span>
  <span>{orgao}</span>
  <span aria-hidden="true">·</span>
  <span>{cargo}</span>
  <span aria-hidden="true">·</span>
  <span>{ano}</span>
  {
    // Assunto é o item final do fluxo — texto puro, sem pílula: o valor é
    // frequentemente ausente ou ruído de seção do PDF ("PROVAS OBJETIVAS"),
    // e a pílula accent destacada por ml-auto dava a ele peso de rótulo do
    // card inteiro, flutuando desconectada da linha. Em fluxo, a posição é
    // determinística mesmo quando a meta quebra em várias linhas. O rótulo
    // sr-only desambigua o campo para leitor de tela — o valor sozinho não
    // é autoevidente como os demais (banca/órgão são nomes próprios, ano é
    // número). cardHtml (templates.ts) replica este markup.
    assunto && (
      <>
        <span aria-hidden="true">·</span>
        <span>
          <span class="sr-only">{'Assunto: '}</span>
          {assunto}
        </span>
      </>
    )
  }
</p>
