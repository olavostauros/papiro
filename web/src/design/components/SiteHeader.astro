---
import Badge from './Badge.astro';
import Container from './Container.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { navItems } from '../nav';

const normalize = (href: string) => href.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<header class="sticky top-0 z-10 border-b border-line bg-paper-glass backdrop-blur">
  <Container class="flex flex-wrap items-center justify-between gap-x-6 py-3 sm:py-4">
    <Logo href={import.meta.env.BASE_URL} />

    <div class="flex items-center gap-3 sm:order-3">
      <div class="hidden sm:block">
        <Badge>HackBrasil</Badge>
      </div>
      <ThemeToggle />
    </div>

    <nav aria-label="Principal" class="order-3 mt-2 w-full sm:order-2 sm:mt-0 sm:w-auto">
      <ul class="flex gap-5 text-sm">
        {
          navItems.map((item) => {
            const active = normalize(item.href) === current;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    '-my-2 rounded-sm py-2 underline-offset-8 transition-colors hover:text-ink focus-visible:focus-ring',
                    active
                      ? 'font-medium text-ink underline decoration-accent decoration-2'
                      : 'text-ink-soft',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Container>
</header>
