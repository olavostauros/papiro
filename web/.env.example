# URL base da API read-only do papiro (FastAPI — api/).
# Sem ela o site constrói com listas vazias e os elementos ficam inertes.
#
#   API local (uvicorn na :8000):  PUBLIC_API_URL=http://localhost:8000
#   API deployada:                 PUBLIC_API_URL=https://api.olavostauros.com
#   Reverse-proxy no mesmo host:   PUBLIC_API_URL=/api   (caminho relativo também vale)
PUBLIC_API_URL=
