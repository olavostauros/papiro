{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env/**)",
      "Read(.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.netrc)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.gnupg/**)",
      "Read(**/*.local.json)",
      "Write(.env)",
      "Write(.env/**)",
      "Write(.env*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pfx)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)",
      "Write(**/.netrc)",
      "Write(**/.ssh/**)",
      "Write(**/.aws/**)",
      "Write(**/*.local.json)",
      "Exec(cat .env)",
      "Exec(cat ./.env)",
      "Exec(head .env)",
      "Exec(tail .env)",
      "Exec(less .env)",
      "Exec(xxd .env)",
      "Exec(base64 .env)",
      "Exec(printenv)",
      "Exec(docker exec)",
      "Exec(docker inspect)",
      "Exec(docker container inspect)",
      "Exec(docker compose exec)",
      "Exec(docker compose config)"
    ]
  }
}
